# surf-mcp Environment Configuration
# Copy to .env and customize for your setup

# =============================================================================
# LM Studio / Fara Configuration (Recommended for local visual grounding)
# =============================================================================

# Multiple LM Studio servers (alias=url format, comma-separated)
# LMSTUDIO_SERVERS=gpu1=http://localhost:1234/v1,gpu2=http://192.168.1.50:1234/v1
LMSTUDIO_SERVERS=default=http://localhost:1234/v1

# Fara model IDs to look for (comma-separated, in priority order)
FARA_MODEL_IDS=microsoft_fara-7b,fara-7b-gguf,gao-zijian/fara-7b

# Failover and retry settings
FARA_MAX_FAILURES=2
FARA_PROBE_TIMEOUT=2.0

# Confidence thresholds
FARA_MIN_CONFIDENCE=0.7
FARA_CONFIDENCE_RETRIES=2

# Max steps for autonomous mode (act_autonomous)
FARA_MAX_AGENT_STEPS=20

# =============================================================================
# Alternative: OpenAI-compatible API
# =============================================================================

# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# SURF_LLM_MODEL=gpt-4o

# =============================================================================
# Alternative: Google Gemini
# =============================================================================

# GOOGLE_API_KEY=...
# SURF_LLM_PROVIDER=gemini
# SURF_LLM_MODEL=gemini-2.0-flash

# =============================================================================
# Browser Configuration
# =============================================================================

# Run browser without visible window
SURF_BROWSER_HEADLESS=true

# Viewport size (affects screenshot dimensions)
SURF_BROWSER_VIEWPORT_WIDTH=1920
SURF_BROWSER_VIEWPORT_HEIGHT=1080

# =============================================================================
# Session Management
# =============================================================================

# Maximum concurrent browser sessions
SURF_MAX_SESSIONS=10

# Session timeout in seconds (cleanup idle sessions)
SURF_SESSION_TIMEOUT_SECONDS=3600

# =============================================================================
# Logging
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
SURF_LOG_LEVEL=INFO

# =============================================================================
# Proxy (optional)
# =============================================================================

# HTTP_PROXY=http://proxy:8080
# HTTPS_PROXY=http://proxy:8080
