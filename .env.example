# .env.example - Configuration for surf-mcp
#
# Copy this file to .env and configure your environment.

# ===================================================================
#  LM STUDIO MULTI-SERVER CONFIGURATION
# ===================================================================

# Server mapping: name=url format (URLs contain : so use = separator)
# Supports multiple GPUs/machines. Discovery will probe each server
# and prefer ones with the target model already loaded.
#
# Example with two GPUs:
LMSTUDIO_SERVERS="rtx3090=http://localhost:1234/v1,rtx8000=http://192.168.137.2:1234/v1"
#
# Single server:
# LMSTUDIO_SERVERS="default=http://localhost:1234/v1"

# Fallback base URL if LMSTUDIO_SERVERS not set
LMSTUDIO_BASE_URL="http://localhost:1234/v1"
LMSTUDIO_TIMEOUT=300

# ===================================================================
#  FARA VISUAL GROUNDING CONFIGURATION
# ===================================================================

# Priority-ordered list of acceptable Fara model IDs
# Will check each server's /v1/models manifest for these IDs.
# Prefers servers with the model already loaded (state: "loaded").
FARA_MODEL_IDS="microsoft_fara-7b,fara-7b-gguf,gao-zijian/fara-7b"

# Max failures before giving up on visual grounding
FARA_MAX_FAILURES=2

# Timeout for probing server manifests (seconds)
FARA_PROBE_TIMEOUT=2.0

# ===================================================================
#  CLOUD PROVIDER (Alternative to LM Studio)
# ===================================================================

# For Google Gemini visual grounding (instead of Fara)
# GOOGLE_API_KEY="your_gemini_api_key"

# For OpenAI GPT-4V visual grounding
# OPENAI_API_KEY="your_openai_api_key"

# ===================================================================
#  BROWSER CONFIGURATION
# ===================================================================

# SURF_BROWSER_HEADLESS=true
# SURF_BROWSER_VIEWPORT_WIDTH=1920
# SURF_BROWSER_VIEWPORT_HEIGHT=1080

# ===================================================================
#  SESSION MANAGEMENT
# ===================================================================

# SURF_MAX_SESSIONS=10
# SURF_SESSION_TIMEOUT_SECONDS=3600
